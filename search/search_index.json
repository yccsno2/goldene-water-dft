{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6c34\u5206\u5b50\u65bc\u91d1\u70ef\u8868\u9762\u4e4b\u5438\u9644\u884c\u70ba\u8207\u50ac\u5316\u6a5f\u5236\uff1a\u7b2c\u4e00\u6027\u539f\u7406\u7814\u7a76","text":""},{"location":"#first-principles-study-on-the-adsorption-behavior-and-catalytic-mechanism-of-water-molecules-on-goldene","title":"First-Principles Study on the Adsorption Behavior and Catalytic Mechanism of Water Molecules on Goldene","text":"\u88fd\u4f5c\u4eba\uff1a\u7269\u7406\u56db 411214215 \u8449\u4ef2\u5091 \u6307\u5c0e\u6559\u6388\uff1a\u5f35\u4fca\u660e\u8001\u5e2b"},{"location":"abstract/","title":"\u6458\u8981","text":"<p>\uff08\u6b64\u8655\u53ef\u586b\u5165\u5c08\u984c\u4e2d\u82f1\u6587\u7814\u7a76\u6458\u8981\uff0c\u7c21\u8ff0\u7814\u7a76\u80cc\u666f\u3001\u8a08\u7b97\u65b9\u6cd5\u3001\u4e3b\u8981\u5438\u9644\u4f4d\u9ede\u7d50\u679c\u8207\u50ac\u5316\u6a5f\u5236\u7d50\u8ad6\u3002\uff09</p>"},{"location":"analysis/","title":"\u6578\u64da\u5206\u6790","text":"<p>\uff08\u6b64\u8655\u53ef\u653e\u4e0a VESTA \u6e32\u67d3\u4e4b\u5404\u5438\u9644\u4f4d\u9ede\u5074\u8996\u5716\u8207\u4fef\u8996\u5716\uff0c\u4e26\u6bd4\u8f03\u4e0d\u540c\u4f4d\u9ede\u4e4b\u5438\u9644\u80fd\u5f37\u5f31\u3001\u5206\u5b50\u50be\u89d2\u504f\u597d\u3001\\(\\text{O\u2013H}\\) \u9375\u9577\u8b8a\u5316\u8207\u96fb\u8377\u8f49\u79fb\u8da8\u52e2\u3002\uff09</p>"},{"location":"conclusion/","title":"\u7d50\u8ad6","text":"<p>\uff08\u6b64\u8655\u53ef\u689d\u5217\u7e3d\u7d50\u672c\u5c08\u984c\u95dc\u65bc\u6c34\u5206\u5b50\u5728\u91d1\u70ef\u8868\u9762\u4e4b\u6700\u7a69\u5b9a\u5438\u9644\u4f4d\u9ede\u3001DFT-D3 \u4fee\u6b63\u5f71\u97ff\uff0c\u4ee5\u53ca\u50ac\u5316\u53cd\u61c9\u6a5f\u5236\u4e4b\u6838\u5fc3\u767c\u73fe\u3002\uff09</p>"},{"location":"data/","title":"\u5be6\u9a57\u6578\u64da","text":""},{"location":"data/#vasp","title":"VASP \u8a08\u7b97\u8f38\u5165\u8207\u6536\u6582\u7d50\u69cb\u6a94","text":"<p>\u9ede\u64ca\u4e0b\u65b9\u9023\u7d50\u53ef\u76f4\u63a5\u6aa2\u8996\u6216\u4e0b\u8f09\u5404\u7cfb\u7d71\u4e4b <code>INCAR</code>\u3001<code>KPOINTS</code>\u3001<code>POSCAR</code>\u3001<code>CONTCAR</code> \u8207 <code>OSZICAR</code>\uff1a</p> <ul> <li>\u57fa\u5e95\u8207\u6c23\u76f8\u5206\u5b50\uff1agoldene \uff5c goldene_relax \uff5c water</li> <li>\u6c34\u5206\u5b50\u521d\u59cb\u5438\u9644\u614b\uff1aistop \uff5c isbridge \uff5c ishollow</li> </ul>"},{"location":"data/#_2","title":"\u57fa\u6e96\u7cfb\u7d71\u7e3d\u80fd\u91cf","text":"\u7cfb\u7d71\u540d\u7a31 \u7e3d\u80fd\u91cf \\(E\\) (eV) \u5099\u8a3b Clean Goldene (\\(6 \\times 3 \\times 1\\)) \u5f85\u586b\u5165 36 Au atoms Isolated \\(\\text{H}_2\\text{O}\\) \u5f85\u586b\u5165 <code>IDIPOL = 4</code>"},{"location":"data/#texth_2texto","title":"\\(\\text{H}_2\\text{O}\\) \u5404\u5438\u9644\u4f4d\u9ede\u8a08\u7b97\u6578\u64da","text":"\u521d\u59cb\u5438\u9644\u69cb\u578b \u7e3d\u80fd\u91cf \\(E_{\\text{slab+mol}}\\) (eV) \u5438\u9644\u80fd \\(E_{\\text{ads}}\\) (eV) \\(\\text{O\u2013Au}\\) \u6700\u8fd1\u8ddd\u96e2 (\u00c5) Top (<code>istop</code>) \u5f85\u586b\u5165 \u5f85\u586b\u5165 \u5f85\u586b\u5165 Bridge (<code>isbridge</code>) \u5f85\u586b\u5165 \u5f85\u586b\u5165 \u5f85\u586b\u5165 Hollow (<code>ishollow</code>) \u5f85\u586b\u5165 \u5f85\u586b\u5165 \u5f85\u586b\u5165"},{"location":"methodology/","title":"\u5be6\u9a57\u65b9\u6cd5","text":"<p>\u672c\u7814\u7a76\u4f7f\u7528\u7b2c\u4e00\u539f\u7406\u8a08\u7b97\u8edf\u9ad4 VASP\uff08Vienna Ab initio Simulation Package\uff09 \u9032\u884c\u81ea\u6d3d\u5834\uff08SCF\uff09\u96fb\u5b50\u7d50\u69cb\u8a08\u7b97\u8207\u96e2\u5b50\u5f1b\u8c6b\u5e7e\u4f55\u6700\u4f73\u5316\uff08Geometry Optimization\uff09\uff0c\u4e26\u900f\u904e VESTA \u9032\u884c\u6676\u9ad4\u7d50\u69cb\u8996\u89ba\u5316\u8207\u9375\u9577\u3001\u5438\u9644\u9ad8\u5ea6\u91cf\u6e2c\u3002</p>"},{"location":"motivation/","title":"\u52d5\u6a5f","text":"<p>\u4e8c\u7dad\u55ae\u539f\u5b50\u5c64\u91d1\uff08Goldene\uff09\u8fd1\u5e74\u6210\u529f\u65bc\u5be6\u9a57\u4e0a\u5408\u6210\uff0c\u5176\u4f4e\u914d\u4f4d\u6578\u8868\u9762\u539f\u5b50\u5c55\u73fe\u51fa\u8207\u584a\u6750\u91d1\u622a\u7136\u4e0d\u540c\u7684\u96fb\u5b50\u7d50\u69cb\u8207\u8868\u9762\u53cd\u61c9\u6d3b\u6027\u3002\u63a2\u8a0e\u6c34\u5206\u5b50\u5728\u91d1\u70ef\u8868\u9762\u7684\u5438\u9644\u69cb\u578b\u8207\u89e3\u96e2\u884c\u70ba\uff0c\u6709\u52a9\u65bc\u91d0\u6e05\u4e8c\u7dad\u8cb4\u91d1\u5c6c\u6750\u6599\u5728\u8868\u9762\u50ac\u5316\u8207\u6c34\u88c2\u89e3\u53cd\u61c9\u4e2d\u7684\u6f5b\u5728\u61c9\u7528\u6a5f\u5236\u3002</p>"},{"location":"objectives/","title":"\u76ee\u7684","text":"<ol> <li>\u5efa\u7acb\u7a69\u5b9a\u4e4b\u91d1\u70ef\u55ae\u5c64\u6a21\u578b\uff1a\u6700\u4f73\u5316 36 \u539f\u5b50 \\(6 \\times 3 \\times 1\\) \u91d1\u70ef\u8d85\u6676\u80de\u7d50\u69cb\u4e26\u78ba\u8a8d\u5176\u57fa\u6e96\u80fd\u91cf\u3002</li> <li>\u9451\u5b9a\u6c34\u5206\u5b50\u6700\u7a69\u5b9a\u5438\u9644\u69cb\u578b\uff1a\u6bd4\u8f03 \\(\\text{H}_2\\text{O}\\) \u65bc Top\u3001Bridge\u3001Hollow \u7b49\u9ad8\u5c0d\u7a31\u4f4d\u9ede\uff08\u542b\u4e0d\u540c\u5206\u5b50\u50be\u89d2\u69cb\u578b\uff09\u4e4b\u5438\u9644\u80fd\u8207\u9375\u9577\u8b8a\u5316\u3002</li> <li>\u8a55\u4f30\u50ac\u5316\u89e3\u96e2\u71b1\u529b\u5b78\u8def\u5f91\uff1a\u5206\u6790\u6c34\u5206\u5b50\u89e3\u96e2\u70ba\u5171\u5438\u9644\u7269\u7a2e\uff08\\(\\text{OH}^* + \\text{H}^*\\)\uff09\u4e4b\u80fd\u91cf\u8b8a\u5316\u8207\u53cd\u61c9\u53ef\u884c\u6027\u3002</li> </ol>"},{"location":"setup/","title":"\u5be6\u9a57\u8a2d\u5b9a","text":""},{"location":"setup/#_2","title":"\u8a08\u7b97\u6a21\u578b\u8a2d\u5b9a","text":"<ul> <li>\u57fa\u5e95\u8d85\u6676\u80de\uff1a36 \u539f\u5b50\u55ae\u5c64\u91d1\u70ef\uff08\\(6 \\times 3 \\times 1\\)\uff09</li> <li>\u771f\u7a7a\u5c64\u539a\u5ea6\uff1a\u6cbf \\(z\\) \u8ef8\u65b9\u5411\u4fdd\u7559\u5145\u8db3\u771f\u7a7a\u5c64\uff0c\u6d88\u9664\u9031\u671f\u6027\u908a\u754c\u689d\u4ef6\u9020\u6210\u7684\u5c64\u9593\u4ea4\u4e92\u4f5c\u7528\u3002</li> </ul>"},{"location":"setup/#vasp-incar","title":"VASP \u6838\u5fc3\u53c3\u6578\uff08INCAR\uff09","text":"\u53c3\u6578\u540d\u7a31 \u8a2d\u5b9a\u503c \u8aaa\u660e \u6cdb\u51fd PAW-PBE \u6295\u5f71\u7db4\u52a0\u6ce2\u8d17\u52e2\u8207 PBE \u6cdb\u51fd \u8272\u6563\u4fee\u6b63 <code>IVDW = 11</code> DFT-D3 \u7121\u963b\u5c3c\u51e1\u5f97\u74e6\u4fee\u6b63 \u622a\u65b7\u80fd <code>ENCUT = 400</code> eV \u5e73\u9762\u6ce2\u57fa\u5e95\u622a\u65b7\u80fd \u96fb\u5b50\u6536\u6582\u6a19\u6e96 <code>EDIFF = 1E-6</code> eV SCF \u80fd\u91cf\u6536\u6582\u95be\u503c \u96e2\u5b50\u6536\u6582\u6a19\u6e96 <code>EDIFFG = -0.01</code> eV/\u00c5 \u539f\u5b50\u6700\u5927\u6b98\u9918\u53d7\u529b\u95be\u503c \u5c55\u5bec\u8a2d\u5b9a <code>ISMEAR = 0</code>, <code>SIGMA = 0.05</code> \u9ad8\u65af\u5c55\u5bec\uff08Gaussian smearing\uff09 \u6700\u4f73\u5316\u6f14\u7b97\u6cd5 <code>IBRION = 2</code>, <code>POTIM = 0.1</code> \u5171\u8edb\u68af\u5ea6\u6cd5\uff08CG\uff09 \u5076\u6975\u4fee\u6b63 <code>LDIPOL = .TRUE.</code> \u5e73\u677f\u8a2d <code>IDIPOL = 3</code>\uff1b\u5b64\u7acb\u5206\u5b50\u8a2d <code>IDIPOL = 4</code>"},{"location":"theory/","title":"\u539f\u7406","text":""},{"location":"theory/#1-dft","title":"1. \u91cf\u5b50\u529b\u5b78\u57fa\u790e\u8207\u5bc6\u5ea6\u6cdb\u51fd\u7406\u8ad6\uff08DFT\uff09","text":"<p>\u7b2c\u4e00\u539f\u7406\u8a08\u7b97\uff08First-principles calculations\uff09\u4e0d\u4f9d\u8cf4\u4efb\u4f55\u7d93\u9a57\u53c3\u6578\uff0c\u76f4\u63a5\u5f9e\u91cf\u5b50\u529b\u5b78\u57fa\u672c\u5b9a\u5f8b\u51fa\u767c\u6c42\u89e3\u591a\u96fb\u5b50\u7cfb\u7d71\u7684\u96fb\u5b50\u7d50\u69cb\u8207\u57fa\u614b\u6027\u8cea\uff0c\u5176\u6838\u5fc3\u70ba\u975e\u76f8\u5c0d\u8ad6\u5b9a\u614b\u859b\u4e01\u683c\u65b9\u7a0b\u5f0f\uff1a</p> \\[H\\Psi = E\\Psi\\] <p>\u5176\u4e2d \\(H\\) \u70ba\u7cfb\u7d71\u7684\u54c8\u5bc6\u9813\u7b97\u7b26\uff08Hamiltonian\uff09\uff0c\\(\\Psi\\) \u70ba\u591a\u9ad4\u6ce2\u51fd\u6578\uff0c\\(E\\) \u70ba\u7cfb\u7d71\u7e3d\u80fd\u91cf\u3002\u91dd\u5c0d\u5305\u542b\u5927\u91cf\u539f\u5b50\u8207\u96fb\u5b50\u7684\u5be6\u969b\u6750\u6599\u7cfb\u7d71\uff0c\u672c\u5c08\u984c\u63a1\u7528\u5bc6\u5ea6\u6cdb\u51fd\u7406\u8ad6\uff08Density Functional Theory, DFT\uff09\uff0c\u900f\u904e Kohn-Sham \u65b9\u7a0b\u5f0f\u5c07\u8907\u96dc\u7684\u591a\u96fb\u5b50\u4ea4\u4e92\u4f5c\u7528\u554f\u984c\u6620\u5c04\u70ba\u7b49\u6548\u7684\u55ae\u96fb\u5b50\u5728\u6709\u6548\u4f4d\u52e2\u4e2d\u904b\u52d5\u7684\u554f\u984c\uff0c\u85c9\u7531\u96fb\u5b50\u5bc6\u5ea6 \\(\\rho(\\mathbf{r})\\) \u7cbe\u78ba\u6c42\u89e3\u7cfb\u7d71\u57fa\u614b\u80fd\u91cf\u8207\u96fb\u5b50\u5206\u4f48\u3002</p>"},{"location":"theory/#2-hellmann-feynman","title":"2. \u539f\u5b50\u53d7\u529b\u8207\u7d50\u69cb\u6700\u4f73\u5316\uff08Hellmann-Feynman \u5b9a\u7406\uff09","text":"<p>\u5728\u5e7e\u4f55\u7d50\u69cb\u6700\u4f73\u5316\uff08Geometry Optimization\uff09\u8207\u5206\u5b50\u52d5\u529b\u5b78\u6a21\u64ec\u4e2d\uff0c\u5fc5\u9808\u7cbe\u78ba\u8a08\u7b97\u6bcf\u500b\u539f\u5b50\u6838\u6240\u53d7\u7684\u5408\u529b\u3002\u6839\u64da Hellmann-Feynman \u5b9a\u7406\uff0c\u539f\u5b50\u6838\u5728\u4f4d\u7f6e \\(\\mathbf{R}\\) \u6240\u53d7\u7684\u91cf\u5b50\u529b\u5b78\u4f5c\u7528\u529b\u53ef\u7531\u57fa\u614b\u6ce2\u51fd\u6578\u8207\u54c8\u5bc6\u9813\u7b97\u7b26\u5c0d\u539f\u5b50\u5ea7\u6a19\u7684\u504f\u5fae\u5206\u6c42\u5f97\uff1a</p> \\[\\mathbf{F} = -\\left\\langle \\Psi \\left| \\frac{\\partial H}{\\partial \\mathbf{R}} \\right| \\Psi \\right\\rangle\\] <p>\u5728 VASP \u8a08\u7b97\u4e2d\uff0c\u7cfb\u7d71\u6703\u53cd\u8986\u9032\u884c\u81ea\u6d3d\u5834\uff08SCF\uff09\u96fb\u5b50\u6b65\u6536\u6582\u4ee5\u7372\u5f97\u7cbe\u78ba\u96fb\u5b50\u5bc6\u5ea6\uff0c\u518d\u4f9d\u64da\u4e0a\u8ff0\u539f\u5b50\u53d7\u529b\u63a8\u52d5\u96e2\u5b50\u79fb\u52d5\uff0c\u76f4\u5230\u6240\u6709\u539f\u5b50\u7684\u6700\u5927\u6b98\u9918\u53d7\u529b\u4f4e\u65bc\u6536\u6582\u6a19\u6e96\uff08<code>EDIFFG = -0.01</code> eV/\u00c5\uff09\uff0c\u85c9\u6b64\u627e\u51fa\u6c34\u5206\u5b50\u65bc\u91d1\u70ef\u8868\u9762\u7684\u7a69\u5b9a\u5438\u9644\u69cb\u578b\u3002</p>"},{"location":"theory/#3","title":"3. \u4ea4\u63db\u95dc\u806f\u6cdb\u51fd\u8207\u51e1\u5f97\u74e6\u529b\u4fee\u6b63","text":"<p>\u70ba\u7cbe\u78ba\u63cf\u8ff0\u4e8c\u7dad\u55ae\u539f\u5b50\u5c64\u91d1\uff08Goldene\uff09\u4e4b\u96fb\u5b50\u7d50\u69cb\u8207\u8868\u9762\u5438\u9644\u884c\u70ba\uff0c\u672c\u5c08\u984c\u63a1\u7528\u4ee5\u4e0b\u7406\u8ad6\u8fd1\u4f3c\uff1a</p> <ul> <li>\u4ea4\u63db\u95dc\u806f\u6cdb\u51fd\uff08GGA-PBE\uff09\uff1a\u63a1\u7528\u5ee3\u7fa9\u68af\u5ea6\u8fd1\u4f3c\uff08Generalized Gradient Approximation\uff09\u4e2d\u7684 PBE \u6cdb\u51fd\uff0c\u540c\u6642\u8003\u91cf\u96fb\u5b50\u5bc6\u5ea6\u53ca\u5176\u68af\u5ea6\u8b8a\u5316\uff0c\u80fd\u6e96\u78ba\u63cf\u8ff0\u91d1\u5c6c\u8868\u9762\u8207\u5438\u9644\u5206\u5b50\u9593\u7684\u5171\u50f9\u8207\u6975\u6027\u4ea4\u4e92\u4f5c\u7528\u3002</li> <li>\u8272\u6563\u529b\u4fee\u6b63\uff08DFT-D3\uff09\uff1a\u50b3\u7d71 DFT \u6cdb\u51fd\u96e3\u4ee5\u5b8c\u6574\u6355\u6349\u9577\u7a0b\u51e1\u5f97\u74e6\u529b\uff08van der Waals interaction\uff09\u3002\u672c\u5c08\u984c\u5f15\u5165 Grimme \u63d0\u51fa\u7684 DFT-D3 \u8272\u6563\u4fee\u6b63\uff08<code>IVDW = 11</code>\uff09\uff0c\u900f\u904e\u539f\u5b50\u5c0d\u4e4b\u9593\u7684\u8272\u6563\u80fd\u91cf\u9805\u88dc\u5f37\u6975\u6027\u6c34\u5206\u5b50\uff08\\(\\text{H}_2\\text{O}\\)\uff09\u8207\u4e8c\u7dad\u91d1\u5c6c\u8868\u9762\u4e4b\u9593\u7684\u5f31\u4ea4\u4e92\u4f5c\u7528\uff0c\u907f\u514d\u4f4e\u4f30\u7269\u7406\u5438\u9644\u5f37\u5ea6\u3002</li> </ul>"},{"location":"theory/#4","title":"4. \u5438\u9644\u80fd\u71b1\u529b\u5b78\u5b9a\u7fa9","text":"<p>\u70ba\u91cf\u5316\u6c34\u5206\u5b50\u8207\u89e3\u96e2\u7269\u7a2e\uff08\\(\\text{OH}\\)\u3001\\(\\text{H}\\)\uff09\u5728\u91d1\u70ef\u4e0d\u540c\u9ad8\u5c0d\u7a31\u4f4d\u9ede\uff08Top\u3001Bridge\u3001Hollow\uff09\u7684\u7d50\u5408\u7a69\u5b9a\u5ea6\uff0c\u5438\u9644\u80fd \\(E_{\\text{ads}}\\) \u5b9a\u7fa9\u70ba\uff1a</p> \\[E_{\\text{ads}} = E_{\\text{slab+mol}} - E_{\\text{slab}} - E_{\\text{mol}}\\] <ul> <li>\\(E_{\\text{slab+mol}}\\)\uff1a\u5438\u9644\u7269\u7a2e\u8207\u91d1\u70ef\u57fa\u5e95\u5f62\u6210\u8907\u5408\u7cfb\u7d71\u4e26\u5b8c\u6210\u7d50\u69cb\u5f1b\u8c6b\u5f8c\u4e4b\u7e3d\u80fd\u91cf</li> <li>\\(E_{\\text{slab}}\\)\uff1a\u6f54\u6de8 36 \u539f\u5b50\u55ae\u5c64\u91d1\u70ef\u57fa\u5e95\u4e4b\u7e3d\u80fd\u91cf</li> <li>\\(E_{\\text{mol}}\\)\uff1a\u6c23\u76f8\u5b64\u7acb\u5206\u5b50\u4e4b\u7e3d\u80fd\u91cf</li> </ul> <p>\u7576\u8a08\u7b97\u6240\u5f97\u4e4b \\(E_{\\text{ads}} &lt; 0\\) \u6642\uff0c\u8868\u793a\u8a72\u5438\u9644\u904e\u7a0b\u70ba\u653e\u71b1\u53cd\u61c9\uff0c\u4e14\u8ca0\u503c\u8d8a\u5927\u4ee3\u8868\u5438\u9644\u69cb\u578b\u5728\u71b1\u529b\u5b78\u4e0a\u8d8a\u7a69\u5b9a\u3002</p>"},{"location":"theory/#5","title":"5. \u8a08\u7b97\u6750\u6599\u79d1\u5b78\u4e4b\u591a\u5c3a\u5ea6\u6a21\u64ec\u5b9a\u4f4d","text":"<p>\u5728\u73fe\u4ee3\u8a08\u7b97\u6750\u6599\u79d1\u5b78\u4e2d\uff0c\u4e0d\u540c\u7406\u8ad6\u6a21\u64ec\u65b9\u6cd5\u5728\u8a08\u7b97\u7cbe\u78ba\u5ea6\uff08Accuracy\uff09\u8207\u8a08\u7b97\u6548\u7387\uff08Efficiency\uff09\u4e4b\u9593\u5404\u6709\u5b9a\u4f4d\uff1a</p> \u6a21\u64ec\u65b9\u6cd5 \u6838\u5fc3\u65b9\u7a0b\u5f0f / \u6578\u5b78\u67b6\u69cb \u7279\u6027\u8207\u9069\u7528\u5c3a\u5ea6 \u7b2c\u4e00\u539f\u7406\u8a08\u7b97\uff08DFT\uff09 \\(H\\Psi = E\\Psi\\)\uff0c$\\mathbf{F} = -\\langle\\Psi \\frac{\\partial H}{\\partial \\mathbf{R}} \u6a5f\u5668\u5b78\u7fd2\u52e2\u80fd\uff08MLP\uff09 \\(U(\\mathbf{X}) = \\sum_{i_B} w_{i_B} K(\\mathbf{X}, \\mathbf{X}_{i_B})\\) \u900f\u904e\u7d50\u69cb\u63cf\u8ff0\u7b26 \\(\\mathbf{X}\\) \u64ec\u5408 DFT \u4f4d\u80fd\u9762\uff0c\u517c\u9867\u63a5\u8fd1\u7b2c\u4e00\u539f\u7406\u7684\u6e96\u78ba\u5ea6\u8207\u5927\u5c3a\u5ea6\u6a21\u64ec\u6548\u7387 \u53e4\u5178\u5206\u5b50\u52d5\u529b\u5b78\uff08MD\uff09 \\(\\mathbf{F} = -\\nabla U = m\\mathbf{a}\\) \u8a08\u7b97\u6548\u7387\u6700\u9ad8\uff0c\u9069\u5408\u6a21\u64ec\u6578\u842c\u81f3\u6578\u767e\u842c\u539f\u5b50\u4e4b\u9577\u6642\u9593\u71b1\u529b\u5b78\u6f14\u5316\u8207\u50b3\u8f38\u6027\u8cea <p>\u7531\u65bc\u672c\u5c08\u984c\u7684\u6838\u5fc3\u76ee\u6a19\u5728\u65bc\u63a2\u8a0e\u6c34\u5206\u5b50\u65bc\u4e8c\u7dad\u91d1\u70ef\u8868\u9762\u7684\u96fb\u5b50\u7d50\u69cb\u4ea4\u4e92\u4f5c\u7528\u3001\u7cbe\u78ba\u5438\u9644\u80fd\u6392\u5e8f\u4ee5\u53ca\u6c34\u5206\u5b50\u89e3\u96e2\u50ac\u5316\u6a5f\u5236\uff0c\u56e0\u6b64\u63a1\u7528\u5177\u5099\u6700\u9ad8\u91cf\u5b50\u529b\u5b78\u7cbe\u78ba\u5ea6\u7684\u7b2c\u4e00\u539f\u7406 DFT \u65b9\u6cd5\u9032\u884c\u7814\u7a76\u3002</p>"}]}